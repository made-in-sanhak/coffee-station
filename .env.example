# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요.  (.env 는 Git에 올리지 않습니다)
#   cp .env.example .env

# --- 서버 ---
PORT=8080

# --- DB (로컬: docker-compose 의 MySQL / 배포: AWS RDS 주소) ---
# 로컬 DB는 처음 docker compose up 할 때 아래 값으로 만들어집니다. 이름·비밀번호는 각자 정해도 됩니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_station
DB_USER=coffee
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- 인증 ---
# 로그인 JWT 와 AI 추천 확인 토큰 서명에 함께 사용합니다. (비어 있으면 추천 준비·확인이 503)
# 배포 시 EC2 2대에 반드시 같은 값을 넣으세요. 생성 예: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_MAP_JS_KEY=

# --- 외부 AI·OCR ---
GEMINI_API_KEY=
GEMINI_MODEL=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# --- 프론트엔드 ---
# false 로 두면 모의 응답 대신 설정된 백엔드 API를 호출합니다.
USE_MOCK_API=

# --- AI 추천 (Express 에서 Gemini 직접 호출) ---
# mock: 외부 호출 없는 모의 모드(기본) / gemini: GEMINI_API_KEY, GEMINI_MODEL 필요
EXTRACTION_MODE=mock
# Python 리뷰 분석·실습 코드 설정은 ai-server/.env.example 을 참고하세요.

# --- AWS (로컬 개발용. EC2 에서는 IAM 역할을 사용하므로 비워둡니다) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
