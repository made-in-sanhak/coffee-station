# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요.  (.env 는 Git에 올리지 않습니다)
#   cp .env.example .env

# --- 서버 ---
PORT=8080

# --- DB (로컬: docker-compose 의 MySQL / 배포: AWS RDS 주소) ---
# 로컬 DB는 처음 docker compose up 할 때 아래 값으로 만들어집니다. 이름·비밀번호는 각자 정해도 됩니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_station
DB_USER=coffee
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- 인증 ---
JWT_SECRET=change-me-to-a-long-random-string
KAKAO_REST_API_KEY=

# --- 외부 AI·OCR ---
OPENAI_API_KEY=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_MAP_JS_KEY=

# --- 프론트엔드 ---
# false 로 두면 가짜 데이터 대신 실제 Spring 서버를 호출합니다.
USE_MOCK_API=

# --- AI 서버 (ai-server 를 사용하는 경우) ---
AI_SERVER_URL=http://localhost:8000
INTERNAL_API_TOKEN=change-me

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
