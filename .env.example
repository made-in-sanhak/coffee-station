# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요.  (.env 는 Git에 올리지 않습니다)
#   cp .env.example .env

# --- DB (로컬 docker-compose) ---
POSTGRES_DB=coffee_station
POSTGRES_USER=coffee
POSTGRES_PASSWORD=change-me

# --- Spring ↔ AI 서버 공유 비밀값 ---
INTERNAL_API_TOKEN=change-me

# --- 외부 API ---
OPENAI_API_KEY=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_MAP_JS_KEY=

# --- 프론트엔드 ---
# false 로 두면 가짜 데이터 대신 실제 Spring 서버를 호출합니다.
USE_MOCK_API=

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
