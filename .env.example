# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요.  (.env 는 Git에 올리지 않습니다)
#   cp .env.example .env

# --- 서버 ---
PORT=8080

# --- DB (로컬: docker-compose 의 MySQL / 배포: AWS RDS 주소) ---
# 로컬 DB는 처음 docker compose up 할 때 아래 값으로 만들어집니다. 이름·비밀번호는 각자 정해도 됩니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_station
DB_USER=coffee
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- 인증 ---
JWT_SECRET=change-me-to-a-long-random-string
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_MAP_JS_KEY=
# --- 외부 AI·OCR ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# --- 프론트엔드 ---
# false 로 두면 모의 응답 대신 설정된 백엔드 API를 호출합니다.
USE_MOCK_API=

# --- Express 자연어 추출 (기본: 외부 호출 없는 모의 모드) ---
# gemini 모드는 GEMINI_API_KEY와 GEMINI_MODEL 설정이 필요합니다.
EXTRACTION_MODE=mock

# --- 이전 Python HTTP 서버 비교·실습용 (현재 실시간 추천에는 불필요) ---
AI_SERVER_URL=http://localhost:8000
INTERNAL_API_TOKEN=change-me
AGENT_REPOSITORY=mock
RECOMMENDATION_MODE=direct
# mysql-demo: 990001 / mysql: 실제 선별 매장 ID (쉼표 구분)
AGENT_CAFE_IDS=990001

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
