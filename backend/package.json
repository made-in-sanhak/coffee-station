{
  "name": "coffee-station-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mvp": "node scripts/start-mvp.cjs mock",
    "dev:mvp:db": "node scripts/start-mvp.cjs mysql-seed",
    "smoke:mvp": "node scripts/smoke-mvp.cjs",
    "test": "npm run build && node --test tests/*.cjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
