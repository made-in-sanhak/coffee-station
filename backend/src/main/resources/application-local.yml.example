# 이 파일을 복사해서 application-local.yml 을 만드세요. (Git 제외 파일)
#   cp application-local.yml.example application-local.yml
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/coffee_station
    username: coffee
    password: change-me          # .env 의 POSTGRES_PASSWORD 와 같게
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
  data:
    redis:
      host: localhost
      port: 6379

jwt:
  secret: change-me-to-a-long-random-string-at-least-32-bytes

kakao:
  rest-api-key: ""

aws:
  s3:
    bucket: ""
  region: ap-northeast-2

ai-server:
  url: http://localhost:8000
  internal-token: change-me      # .env 의 INTERNAL_API_TOKEN 과 같게
